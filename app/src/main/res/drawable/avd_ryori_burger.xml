<?xml version="1.0" encoding="utf-8"?>
<!--
    RYORI BURGER, ANIMATED VECTOR (app info card)
    Converted from art/burger-vanilla-animated.svg (SMIL). Android can't play SMIL, so each
    effect is rebuilt with vector properties:
      - bun drop-in / rise-up  -> group translateY, two steps (overshoot, then settle)
      - patty + lettuce fade    -> fillAlpha / strokeAlpha (groups have no opacity in AVDs)
      - sesame seed pop         -> strokeWidth 0 -> 3 -> 2
    Rest pose is the fully assembled burger, so the card shows it before any animation; starting
    the animation replays the build-up (every animator has an explicit valueFrom).

    Timeline (~1.12s):
         0 -  525ms  top bun drops in / bottom bun rises (overshoot)
       525 -  700ms  both settle
       300 -  500ms  patty + lettuce fade in
       620 - 1120ms  sesame seeds pop, centre -> left -> right
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="200dp"
            android:height="200dp"
            android:viewportWidth="32"
            android:viewportHeight="32">
            <!-- Top bun + sesame seeds -->
            <group android:name="top_bun">
                <path
                    android:fillColor="#E8900A"
                    android:strokeColor="#92400E"
                    android:strokeWidth="1.2"
                    android:strokeLineJoin="round"
                    android:pathData="M27.8,14C26.9,8.3,21.9,4,16,4S5.1,8.3,4.2,14H27.8z" />
                <path
                    android:name="seed_center"
                    android:strokeColor="#7C2D12"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:pathData="M16,8 L16,10" />
                <path
                    android:name="seed_left"
                    android:strokeColor="#7C2D12"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:pathData="M11,9 L11,11" />
                <path
                    android:name="seed_right"
                    android:strokeColor="#7C2D12"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:pathData="M21,9 L21,11" />
            </group>

            <!-- Patty -->
            <path
                android:name="patty"
                android:fillColor="#6B2D07"
                android:fillAlpha="1"
                android:pathData="M3.5,14 H28.5 A0.5,0.5 0 0 1 29,14.5 V16.5 A0.5,0.5 0 0 1 28.5,17 H3.5 A0.5,0.5 0 0 1 3,16.5 V14.5 A0.5,0.5 0 0 1 3.5,14 Z" />

            <!-- Lettuce wave -->
            <path
                android:name="lettuce"
                android:strokeColor="#15803D"
                android:strokeAlpha="1"
                android:strokeWidth="2.2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M4,16l1.5,1c0.9,0.6,2.1,0.6,3,0c0.9-0.6,2.1-0.6,3,0c0.9,0.6,2.1,0.6,3,0c0.9-0.6,2.1-0.6,3,0c0.9,0.6,2.1,0.6,3,0c0.9-0.6,2.1-0.6,3,0c0.9,0.6,2.1,0.6,3,0l1.5-1" />

            <!-- Bottom bun -->
            <group android:name="bottom_bun">
                <path
                    android:fillColor="#E8900A"
                    android:strokeColor="#92400E"
                    android:strokeWidth="1.2"
                    android:strokeLineJoin="round"
                    android:pathData="M27,24H5c-1.1,0-2-0.9-2-2v0c0-1.1,0.9-2,2-2h22c1.1,0,2,0.9,2,2v0C29,23.1,28.1,24,27,24z" />
                <path
                    android:fillColor="#CF7A08"
                    android:strokeColor="#92400E"
                    android:strokeWidth="1.2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M27,24v1.4c0,1.5-1.2,2.6-2.6,2.6H7.6C6.2,28,5,26.8,5,25.4V24" />
            </group>

        </vector>
    </aapt:attr>

    <!-- Top bun: drop in from above, overshoot, settle -->
    <target android:name="top_bun">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-14"
                    android:valueTo="1.2"
                    android:duration="525"
                    android:interpolator="@interpolator/ryori_drop_in" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="1.2"
                    android:valueTo="0"
                    android:duration="175"
                    android:interpolator="@interpolator/ryori_ease" />
            </set>
        </aapt:attr>
    </target>

    <!-- Bottom bun: rise from below, overshoot, settle -->
    <target android:name="bottom_bun">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="14"
                    android:valueTo="-1.2"
                    android:duration="525"
                    android:interpolator="@interpolator/ryori_drop_in" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-1.2"
                    android:valueTo="0"
                    android:duration="175"
                    android:interpolator="@interpolator/ryori_ease" />
            </set>
        </aapt:attr>
    </target>

    <!--
        Delayed pieces start with a "hold" animator (valueFrom == valueTo) instead of a
        startOffset, so they're hidden from the very first frame of a replay rather than
        showing their rest value until the delay passes.
    -->

    <!-- Patty + lettuce fade in -->
    <target android:name="patty">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:duration="300" />
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="200" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="lettuce">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:duration="300" />
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="200" />
            </set>
        </aapt:attr>
    </target>

    <!-- Sesame seeds pop in one after another -->
    <target android:name="seed_center">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:duration="620" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="3"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_seed_pop" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="3"
                    android:valueTo="2"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_ease" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="seed_left">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:duration="760" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="3"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_seed_pop" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="3"
                    android:valueTo="2"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_ease" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="seed_right">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:duration="900" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="0"
                    android:valueTo="3"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_seed_pop" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:valueFrom="3"
                    android:valueTo="2"
                    android:duration="110"
                    android:interpolator="@interpolator/ryori_ease" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
