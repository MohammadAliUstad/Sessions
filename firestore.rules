rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in owner of this user's data. Anonymous accounts are refused: the app's guest
    // mode is local-only now, so no real user reaches Firestore anonymously, and refusing them
    // stops throwaway accounts from writing to the database.
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Everything not matched below is closed
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
